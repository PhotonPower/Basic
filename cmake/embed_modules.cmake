# Writes OUTPUT: a C++ source with all assembler modules (*.s) of the directories in DIRS
# (relative to SOURCE_DIR) as constants, so that basicc does not need the source tree.
# The texts are written as byte arrays, not string literals: MSVC limits a single literal to
# about 16 KB (error C2026), and several modules are larger.
string(REPLACE "," ";" DIRS "${DIRS}")
set(arrays "")
set(body "")
set(index 0)
foreach(dir ${DIRS})
  file(GLOB files ${SOURCE_DIR}/${dir}/*.s)
  list(SORT files)
  foreach(f ${files})
    file(READ ${f} hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
    # Line breaks every 32 bytes keep the generated file readable for editors and compilers.
    string(REGEX REPLACE "((0x..,){32})" "\\1\n" hex "${hex}")
    get_filename_component(name ${f} NAME)
    string(APPEND arrays "static const unsigned char module${index}[] = {\n${hex}0x00};\n\n")
    string(APPEND body "    {\"${dir}\", \"${name}\", reinterpret_cast<const char*>(module${index})},\n")
    math(EXPR index "${index} + 1")
  endforeach()
endforeach()
file(WRITE ${OUTPUT}.tmp "// Generated by cmake/embed_modules.cmake. Do not edit.\n#include \"link/embedded.hpp\"\n\nnamespace basic::link {\n\nnamespace {\n\n${arrays}}  // namespace\n\nconst std::vector<EmbeddedModule>& embeddedModules() {\n    static const std::vector<EmbeddedModule> modules = {\n${body}    };\n    return modules;\n}\n\n}  // namespace basic::link\n")
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different ${OUTPUT}.tmp ${OUTPUT})
