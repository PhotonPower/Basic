# Writes OUTPUT: a C++ source with all assembler modules (*.s) of the directories in DIRS
# (relative to SOURCE_DIR) as string constants, so that basicc does not need the source tree.
string(REPLACE "," ";" DIRS "${DIRS}")
set(body "")
foreach(dir ${DIRS})
  file(GLOB files ${SOURCE_DIR}/${dir}/*.s)
  list(SORT files)
  foreach(f ${files})
    file(READ ${f} text)
    get_filename_component(name ${f} NAME)
    string(APPEND body "    {\"${dir}\", \"${name}\", R\"BASICMODULE(${text})BASICMODULE\"},\n")
  endforeach()
endforeach()
file(WRITE ${OUTPUT}.tmp "// Generated by cmake/embed_modules.cmake. Do not edit.\n#include \"link/embedded.hpp\"\n\nnamespace basic::link {\n\nconst std::vector<EmbeddedModule>& embeddedModules() {\n    static const std::vector<EmbeddedModule> modules = {\n${body}    };\n    return modules;\n}\n\n}  // namespace basic::link\n")
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different ${OUTPUT}.tmp ${OUTPUT})
