# Runs EXE and compares its standard output with the file EXPECTED (differential test of the pc
# target, docs/testing.md).
# INPUT: file with the keyboard input of the program (optional)
# ERRFILE: file with the number of the unhandled runtime error the program ends with (optional)
# GFXFILE: expected digest of the graphics (D25, optional); GFXOUT: where the program writes it
set(run ${EXE})
if(DEFINED GFXFILE AND EXISTS ${GFXFILE})
  file(REMOVE ${GFXOUT}.txt)
  set(run ${CMAKE_COMMAND} -E env BASIC_GFX_OUT=${GFXOUT} ${EXE})
endif()
if(DEFINED INPUT AND EXISTS ${INPUT})
  execute_process(COMMAND ${run} INPUT_FILE ${INPUT} OUTPUT_VARIABLE actual ERROR_VARIABLE errors RESULT_VARIABLE status)
else()
  execute_process(COMMAND ${run} OUTPUT_VARIABLE actual ERROR_VARIABLE errors RESULT_VARIABLE status)
endif()
if(DEFINED GFXFILE AND EXISTS ${GFXFILE})
  file(READ ${GFXFILE} expectedGfx)
  if(EXISTS ${GFXOUT}.txt)
    file(READ ${GFXOUT}.txt actualGfx)
  else()
    set(actualGfx "(no graphics)\n")
  endif()
  if(NOT actualGfx STREQUAL expectedGfx)
    message(FATAL_ERROR "graphics differ from ${GFXFILE} (picture: ${GFXOUT}.ppm)\n--- expected\n${expectedGfx}--- actual\n${actualGfx}")
  endif()
endif()
file(READ ${EXPECTED} expected)
if(NOT actual STREQUAL expected)
  message(FATAL_ERROR "output differs from ${EXPECTED}\n--- expected\n${expected}--- actual\n${actual}${errors}")
endif()
if(DEFINED ERRFILE AND EXISTS ${ERRFILE})
  file(READ ${ERRFILE} code)
  string(STRIP "${code}" code)
  if(status EQUAL 0 OR NOT errors MATCHES "runtime error ${code}:")
    message(FATAL_ERROR "expected the end with runtime error ${code}, got status ${status}\n${errors}")
  endif()
elseif(NOT status EQUAL 0)
  message(FATAL_ERROR "exit status ${status}\n${errors}")
endif()
