' probe1 - klaert offene Sprachfragen am Original (GFA-BASIC 3.5, Amiga)
' Ergebnisdatei: gfa_run.py setzt datei$ auf DH0:probe1.txt (docs/gfa-original.md).
'
datei$="DH0:probe1.txt"
OPEN "O",#1,datei$
ON ERROR GOSUB fehler
PRINT #1,"probe1"
'
' --- 1. Ganzzahl-Ueberlauf in Ausdruecken und bei INC ---
a%=2147483647
PRINT #1,"T1 a%+1"
b%=a%+1
PRINT #1,"   b%=";b%
PRINT #1,"T2 a%*2"
b%=a%*2
PRINT #1,"   b%=";b%
PRINT #1,"T3 INC a%"
INC a%
PRINT #1,"   a%=";a%
w&=32767
PRINT #1,"T4 w&=w&+1"
w&=w&+1
PRINT #1,"   w&=";w&
w&=32767
PRINT #1,"T5 INC w&"
INC w&
PRINT #1,"   w&=";w&
PRINT #1,"T6 b%=3E9"
b%=3E9
PRINT #1,"   b%=";b%
'
' --- 2. Zuweisung Float -> Integer: runden oder abschneiden? ---
b%=2.5
PRINT #1,"T7 2.5->";b%
b%=3.5
PRINT #1,"T8 3.5->";b%
b%=-2.5
PRINT #1,"T9 -2.5->";b%
b%=2.7
PRINT #1,"T10 2.7->";b%
b%=-2.7
PRINT #1,"T11 -2.7->";b%
b%=7/2
PRINT #1,"T12 7/2->";b%
'
' --- 3. DIV, MOD, Division durch 0 ---
PRINT #1,"T13 -7 DIV 2=";-7 DIV 2;" -7 MOD 2=";-7 MOD 2;" 7 MOD -2=";7 MOD -2
PRINT #1,"T14 1 DIV 0"
b%=1 DIV 0
PRINT #1,"T15 1/0"
x=1/0
'
' --- 4. CINT, INT, ROUND ---
PRINT #1,"T16 CINT 0.5 1.5 2.5 -0.5 -1.5:";CINT(0.5);" ";CINT(1.5);" ";CINT(2.5);" ";CINT(-0.5);" ";CINT(-1.5)
PRINT #1,"T17 INT(-0.5)=";INT(-0.5);" ROUND(2.5)=";ROUND(2.5);" ROUND(0.125,2)=";ROUND(0.125,2)
'
' --- 5. FOR-Semantik ---
n%=0
FOR i%=5 TO 1
  INC n%
NEXT i%
PRINT #1,"T18 FOR 5 TO 1: n%=";n%;" i%=";i%
n%=0
FOR i%=1 TO 3
  INC n%
NEXT i%
PRINT #1,"T19 FOR 1 TO 3: n%=";n%;" i%=";i%
e%=3
n%=0
FOR i%=1 TO e%
  INC n%
  IF i%=1
    e%=10
  ENDIF
NEXT i%
PRINT #1,"T20 Endwert geaendert: n%=";n%;" i%=";i%
n%=0
FOR x=0 TO 1 STEP 0.1
  INC n%
NEXT x
PRINT #1,"T21 FOR 0 TO 1 STEP 0.1: n%=";n%;" x=";x
'
' --- 6. Zahlenausgabe (PRINT und STR$) ---
@zahl("T22 0.5",0.5)
@zahl("T23 -0.5",-0.5)
@zahl("T24 1/3",1/3)
@zahl("T25 2/3",2/3)
@zahl("T26 100/3",100/3)
@zahl("T27 0.1+0.2",0.1+0.2)
@zahl("T28 1E-5",1E-05)
@zahl("T29 123456789012",123456789012)
@zahl("T30 1234567890123",1234567890123)
@zahl("T31 1E15",1E+15)
@zahl("T32 1E100",1E+100)
@zahl("T33 -1E-100",-1E-100)
@zahl("T34 PI",PI)
@zahl("T35 2^31",2^31)
@zahl("T36 1",1)
@zahl("T37 0",0)
a%=-12
PRINT #1,"T38 [";1;"][";-1;"][";a%;"]"
PRINT #1,"T39 Komma:";1,2,3
PRINT #1,"T40 STR$(a%)=[";STR$(a%);"]"
'
' --- 7. Ungefaehre Gleichheit == ---
PRINT #1,"T41 1==1+2^-26:";1==1+2^(-26);" 2^-27:";1==1+2^(-27);" 2^-28:";1==1+2^(-28);" 2^-29:";1==1+2^(-29)
'
' --- 8. Binaerformat der Floats ---
@hexbytes("T42 MKD$(1)",MKD$(1))
@hexbytes("T43 MKD$(-2.5)",MKD$(-2.5))
@hexbytes("T44 MKD$(0.1)",MKD$(0.1))
@hexbytes("T45 MKD$(0)",MKD$(0))
@hexbytes("T46 MKS$(1)",MKS$(1))
@hexbytes("T47 MKS$(0.1)",MKS$(0.1))
'
' --- 9. Ueber-/Unterlauf und Fehlernummern ---
PRINT #1,"T48 1E300*1E300"
x=1E+300*1E+300
PRINT #1,"T49 1E-300*1E-300"
x=1E-300*1E-300
PRINT #1,"   x=";x
PRINT #1,"T50 EXP(1000)"
x=EXP(1000)
PRINT #1,"T51 SQR(-1)"
x=SQR(-1)
PRINT #1,"T52 LOG(0)"
x=LOG(0)
DIM f%(5)
PRINT #1,"T53 f%(10)=1"
f%(10)=1
PRINT #1,"T54 VAL"
PRINT #1,"   ";VAL("1.5E3");" ";VAL("&HFF");" ";VAL("%101");" ";VAL(".5x")
'
PRINT #1,"ende"
CLOSE #1
PRINT "fertig: ";datei$
END
'
PROCEDURE fehler
  ' Original: after an error channel #1 is unusable (ERR 24 file not open)
  ' until it is closed and opened again
  e%=ERR
  CLOSE #1
  OPEN "A",#1,datei$
  PRINT #1,"   -> ERR ";e%;" ";ERR$(e%)
  ON ERROR GOSUB fehler
  RESUME NEXT
RETURN
'
PROCEDURE zahl(t$,z)
  PRINT #1,t$;" [";z;"] str$=[";STR$(z);"]"
RETURN
'
PROCEDURE hexbytes(t$,s$)
  LOCAL i%,h$
  h$=""
  FOR i%=1 TO LEN(s$)
    h$=h$+HEX$(ASC(MID$(s$,i%,1)),2)+" "
  NEXT i%
  PRINT #1,t$;": ";h$
RETURN
