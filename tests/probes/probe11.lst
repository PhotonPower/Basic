' probe11 - RESUME NEXT nach Fehlern in Kopf- und Endzeilen von Strukturen (GFA-BASIC 3.5, Amiga)
' Ergebnisdatei: gfa_run.py setzt datei$ auf DH0:probe11.txt (docs/gfa-original.md).
' Frage: geht RESUME NEXT zur naechsten Programmzeile (auch in einen Rumpf hinein) oder hinter
' die ganze Struktur? Anlass: errors2.lst, WHILE 1/k%>0 lief im Original in den Rumpf.
'
datei$="DH0:probe11.txt"
OPEN "O",#1,datei$
g%=0
ON ERROR GOSUB nxt
PRINT #1,"probe11"
'
k%=0
WHILE 10/k%>5
  PRINT #1,"T1 WHILE: Rumpf"
  k%=100
WEND
PRINT #1,"T1 nach WEND"
'
k%=0
IF 1/k%>0
  PRINT #1,"T2 IF: THEN-Zweig"
ELSE
  PRINT #1,"T2 IF: ELSE-Zweig"
ENDIF
PRINT #1,"T2 nach ENDIF"
'
k%=0
IF k%=1
  PRINT #1,"T3 erster Zweig"
ELSE IF 1/k%>0
  PRINT #1,"T3 ELSE IF: Zweig"
ELSE
  PRINT #1,"T3 ELSE-Zweig"
ENDIF
PRINT #1,"T3 nach ENDIF"
'
k%=0
FOR i%=1 TO 10/k%
  PRINT #1,"T4 FOR: Rumpf i%=";i%
  EXIT IF i%>=3
NEXT i%
PRINT #1,"T4 nach NEXT i%=";i%
'
k%=0
c%=0
REPEAT
  INC c%
  PRINT #1,"T5 REPEAT: Rumpf ";c%
UNTIL 1/k%>0 OR c%>=3
PRINT #1,"T5 nach UNTIL c%=";c%
'
k%=0
DO WHILE 1/k%>0
  PRINT #1,"T6 DO WHILE: Rumpf"
  k%=-1
LOOP
PRINT #1,"T6 nach LOOP"
'
k%=0
c%=0
DO
  INC c%
  PRINT #1,"T7 DO: Rumpf ";c%
LOOP UNTIL 1/k%>0 OR c%>=3
PRINT #1,"T7 nach LOOP UNTIL c%=";c%
'
k%=0
SELECT 1/k%
CASE 0
  PRINT #1,"T8 SELECT: CASE 0"
CASE 1
  PRINT #1,"T8 SELECT: CASE 1"
DEFAULT
  PRINT #1,"T8 SELECT: DEFAULT"
ENDSELECT
PRINT #1,"T8 nach ENDSELECT"
'
k%=0
c%=0
WHILE c%<2
  INC c%
  x=1/k%
  PRINT #1,"T9 WHILE-Rumpf nach Fehler ";c%
WEND
PRINT #1,"T9 nach WEND c%=";c%
'
ON ERROR GOSUB rep
k%=0
WHILE 10/k%>5
  PRINT #1,"T10 RESUME: Rumpf (nie)"
WEND
PRINT #1,"T10 nach WEND k%=";k%
'
ON ERROR GOSUB nxt
k%=0
FOR i%=1 TO 2
  PRINT #1,"T12 FOR i%=";i%
NEXT i%
FOR i%=1 TO 3 STEP 10/k%
  PRINT #1,"T12 STEP-Fehler: Rumpf i%=";i%
  EXIT IF i%>=3
NEXT i%
PRINT #1,"T12 nach NEXT i%=";i%
'
notaus:
PRINT #1,"Fehler insgesamt ";g%
PRINT #1,"ende"
CLOSE #1
END
'
PROCEDURE nxt
  e%=ERR
  CLOSE #1
  OPEN "A",#1,datei$
  INC g%
  PRINT #1,"   -> ERR ";e%
  ON ERROR GOSUB nxt
  IF g%>25
    RESUME notaus
  ENDIF
  RESUME NEXT
RETURN
PROCEDURE rep
  e%=ERR
  CLOSE #1
  OPEN "A",#1,datei$
  INC g%
  PRINT #1,"   -> ERR ";e%;", RESUME"
  k%=100
  ON ERROR GOSUB nxt
  RESUME
RETURN
