' probe13 - Transzendente Funktionen: Fehler an den Raendern, Werte (GFA-BASIC 3.5, Amiga)
' Ergebnisdatei: gfa_run.py setzt datei$ auf DH0:probe13.txt (docs/gfa-original.md).
' Die Werte werden auf 8 Stellen gerundet ausgegeben: das Original rechnet mit 48 Bit und ist
' nicht genau (probe2 T16), wir mit binary64 (D11); verglichen wird nur das Verhalten.
'
datei$="DH0:probe13.txt"
OPEN "O",#1,datei$
ON ERROR GOSUB fehler
PRINT #1,"probe13"
'
PRINT #1,"T1 EXP(-30000): ";EXP(-30000)
PRINT #1,"T2 EXP(-745): ";EXP(-745)
PRINT #1,"T3 LOG(-1)"
x=LOG(-1)
PRINT #1,"T4 LOG10(0)"
x=LOG10(0)
PRINT #1,"T5 ASIN(2)"
x=ASIN(2)
PRINT #1,"T6 ACOS(-1.5)"
x=ACOS(-1.5)
PRINT #1,"T7 ASIN(1): ";ROUND(ASIN(1),8);" ACOS(-1): ";ROUND(ACOS(-1),8)
PRINT #1,"T8 (-8)^(1/3)"
x=(-8)^(1/3)
PRINT #1,"T9 0^-1"
x=0^-1
PRINT #1,"T10 0^0: ";0^0;" 0^0.5: ";0^0.5;" (-2)^3: ";(-2)^3;" 2^0.5: ";ROUND(2^0.5,8)
PRINT #1,"T11 TAN(PI/2): ";TAN(PI/2)
PRINT #1,"T12 SIN(1E10): ";ROUND(SIN(1E10),6);" COS(1E10): ";ROUND(COS(1E10),6)
PRINT #1,"T13 SIN(1E20)"
x=SIN(1E20)
PRINT #1,"   = ";x
PRINT #1,"T14 ATN(1E300): ";ROUND(ATN(1E300),8);" ATN(-1): ";ROUND(ATN(-1),8)
PRINT #1,"T15 EXP(1): ";ROUND(EXP(1),8);" LOG(10): ";ROUND(LOG(10),8);" LOG10(1000): ";LOG10(1000)
PRINT #1,"T16 SIN(0.5): ";ROUND(SIN(0.5),8);" COS(0.5): ";ROUND(COS(0.5),8);" TAN(0.5): ";ROUND(TAN(0.5),8)
PRINT #1,"T17 SINQ(30): ";ROUND(SINQ(30),8);" COSQ(60): ";ROUND(COSQ(60),8);" DEG(1): ";ROUND(DEG(1),8);" RAD(180): ";ROUND(RAD(180),8)
PRINT #1,"T18 ASIN(0.5): ";ROUND(ASIN(0.5),8);" ACOS(0.5): ";ROUND(ACOS(0.5),8)
PRINT #1,"T19 10^-2: ";10^-2;" 2^-0.5: ";ROUND(2^-0.5,8);" 1.5^2.5: ";ROUND(1.5^2.5,8)
PRINT #1,"T20 EXP(0): ";EXP(0);" LOG(1): ";LOG(1);" SIN(0): ";SIN(0);" COS(0): ";COS(0);" ATN(0): ";ATN(0)
PRINT #1,"T21 SINQ(1E10): ";ROUND(SINQ(1E10),6)
PRINT #1,"T22 LOG(1E-300): ";ROUND(LOG(1E-300),6);" EXP(700): ";EXP(700)
PRINT #1,"T23 SIN(-0.5): ";ROUND(SIN(-0.5),8);" COS(-3): ";ROUND(COS(-3),8);" TAN(-1): ";ROUND(TAN(-1),8)
'
PRINT #1,"ende"
CLOSE #1
END
'
PROCEDURE fehler
  e%=ERR
  CLOSE #1
  OPEN "A",#1,datei$
  PRINT #1,"   -> ERR ";e%;" ";ERR$(e%)
  ON ERROR GOSUB fehler
  RESUME NEXT
RETURN
