' probe2 - Folgefragen aus probe1 (GFA-BASIC 3.5, Amiga)
' Ergebnisdatei: gfa_run.py setzt datei$ auf DH0:probe2.txt (docs/gfa-original.md).
'
datei$="DH0:probe2.txt"
OPEN "O",#1,datei$
ON ERROR GOSUB fehler
PRINT #1,"probe2"
'
' --- 1. Ganzzahlausdruecke: Integer oder Float? ---
a%=2147483647
x=a%+1
PRINT #1,"T1 x=a%+1: ";x
x=a%*2
PRINT #1,"T2 x=a%*2: ";x
b%=a%+1-1
PRINT #1,"T3 b%=a%+1-1: ";b%
b%=(a%*2) DIV 2
PRINT #1,"T4 b%=(a%*2) DIV 2: ";b%
c|=255
INC c|
PRINT #1,"T5 INC c| von 255: ";c|
c|=255
PRINT #1,"T6 c|=c|+1"
c|=c|+1
PRINT #1,"   c|=";c|
c|=0
DEC c|
PRINT #1,"T7 DEC c| von 0: ";c|
a%=-2147483648
DEC a%
PRINT #1,"T8 DEC a% von -2^31: ";a%
PRINT #1,"T9 -7\2=";-7\2;" 7\-2=";7\-2
'
' --- 2. FOR-Semantik ---
n%=0
FOR i%=5 TO 1 STEP -1
  INC n%
NEXT i%
PRINT #1,"T10 FOR 5 TO 1 STEP -1: n%=";n%;" i%=";i%
n%=0
FOR i%=1 TO 10 STEP 3
  INC n%
NEXT i%
PRINT #1,"T11 FOR 1 TO 10 STEP 3: n%=";n%;" i%=";i%
s%=1
n%=0
FOR i%=1 TO 10 STEP s%
  INC n%
  s%=5
NEXT i%
PRINT #1,"T12 Schritt geaendert: n%=";n%;" i%=";i%
n%=0
FOR i%=2147483646 TO 2147483647
  INC n%
  EXIT IF n%>5
NEXT i%
PRINT #1,"T13 FOR bis 2^31-1: n%=";n%;" i%=";i%
n%=0
FOR x=1 TO 0 STEP -0.25
  INC n%
NEXT x
PRINT #1,"T14 FOR 1 TO 0 STEP -0.25: n%=";n%;" x=";x
'
' --- 3. Fliesskomma-Ueberlauf: welcher Wert? ---
x=1E+300*1E+300
PRINT #1,"T15 1E300*1E300 [";x;"]"
@hexbytes("   MKD$",MKD$(x))
x=EXP(1000)
PRINT #1,"T16 EXP(1000) [";x;"]"
@hexbytes("   MKD$",MKD$(x))
x=-1E+300*1E+300
PRINT #1,"T17 -1E300*1E300 [";x;"]"
@hexbytes("   MKD$",MKD$(x))
x=-1*0
@hexbytes("T18 MKD$(-1*0)",MKD$(x))
'
' --- 4. PI und Ausgabe-Rundung ---
@hexbytes("T19 MKD$(PI)",MKD$(PI))
@hexbytes("T20 MKD$(3.14159265359)",MKD$(3.14159265359))
PRINT #1,"T21 PI-3.14159265359=";PI-3.14159265359
PRINT #1,"T22 3.14159265359 [";3.14159265359;"]"
PRINT #1,"T23 2/3*3 [";2/3*3;"] 1/7 [";1/7;"]"
PRINT #1,"T24 1+1E-12 [";1+1E-12;"] 1+1E-13 [";1+1E-13;"]"
'
' --- 5. Schwellen der Exponentdarstellung ---
PRINT #1,"T25 1E12 [";1E+12;"] 1E13 [";1E+13;"] 1E14 [";1E+14;"]"
PRINT #1,"T26 99999999999999 [";99999999999999;"]"
PRINT #1,"T27 1.5E13 [";1.5E+13;"] 1.5E14 [";1.5E+14;"]"
PRINT #1,"T28 0.001 [";0.001;"] 1E-4 [";1E-04;"]"
PRINT #1,"T29 1E-6 [";1E-06;"] 1E-7 [";1E-07;"] 1E-9 [";1E-09;"]"
PRINT #1,"T30 1.5E-6 [";1.5E-06;"] 1.25E-8 [";1.25E-08;"]"
PRINT #1,"T31 1E-10 [";1E-10;"] 1.5E15 [";1.5E+15;"]"
PRINT #1,"T32 123.456 [";123.456;"] -0.000123 [";-0.000123;"]"
'
' --- 6. DEFNUM ---
DEFNUM 4
PRINT #1,"T33 DEFNUM 4: [";PI;"] [";123456;"] [";0.000123456;"] str$=[";STR$(PI);"]"
DEFNUM 13
'
' --- 7. Ungefaehre Gleichheit == ---
PRINT #1,"T34 1.5: ";1.5==1.5+2^(-29);" ";1.5==1.5+2^(-28)
PRINT #1,"T35 1000: ";1000==1000+1000*2^(-29);" ";1000==1000+1000*2^(-28)
PRINT #1,"T36 1-2^-30: ";1==1-2^(-30);" 1-2^-29: ";1==1-2^(-29);" 1-2^-28: ";1==1-2^(-28)
PRINT #1,"T37 0==1E-20: ";0==1E-20;" 1E-20==2E-20: ";1E-20==2E-20
PRINT #1,"T38 1+2^-29==1+2^-28: ";1+2^(-29)==1+2^(-28)
PRINT #1,"T39 1+3*2^-30: ";1==1+3*2^(-30);" 1+(2^-28-2^-40): ";1==1+(2^(-28)-2^(-40))
'
' --- 8. MKS$ / CVS ---
@hexbytes("T40 MKS$(1)",MKS$(1))
@hexbytes("T41 MKS$(2)",MKS$(2))
@hexbytes("T42 MKS$(-1)",MKS$(-1))
@hexbytes("T43 MKS$(0)",MKS$(0))
PRINT #1,"T44 LEN(MKS$(1))=";LEN(MKS$(1));" CVS(MKS$(1.5))=";CVS(MKS$(1.5))
PRINT #1,"T45 CVD(MKD$(0.1))=";CVD(MKD$(0.1))
'
PRINT #1,"ende"
CLOSE #1
PRINT "fertig: ";datei$
END
'
PROCEDURE fehler
  ' Original: after an error channel #1 is unusable (ERR 24 file not open)
  ' until it is closed and opened again
  e%=ERR
  CLOSE #1
  OPEN "A",#1,datei$
  PRINT #1,"   -> ERR ";e%;" ";ERR$(e%)
  ON ERROR GOSUB fehler
  RESUME NEXT
RETURN
'
PROCEDURE hexbytes(t$,s$)
  LOCAL i%,h$
  h$=""
  FOR i%=1 TO LEN(s$)
    h$=h$+HEX$(ASC(MID$(s$,i%,1)),2)+" "
  NEXT i%
  PRINT #1,t$;": ";h$
RETURN
