' probe4 - SELECT, MODE, PRINT USING, STR$, Operatoren, Strings (GFA-BASIC 3.5, Amiga)
' Ergebnisdatei: gfa_run.py setzt datei$ auf DH0:probe4.txt (docs/gfa-original.md).
'
datei$="DH0:probe4.txt"
OPEN "O",#1,datei$
ON ERROR GOSUB fehler
PRINT #1,"probe4"
'
' --- 1. SELECT mit Strings: Packung ---
' "ab": little-endian 97+256*98=25185, big-endian 97*256+98=24930
@sel2(25185)
@sel2(24930)
' "abcd": 97+256*98+65536*99+16777216*100=1684234849, big-endian 1633837924
@sel4(1684234849)
@sel4(1633837924)
@sel1(97)
' --- 2. CONT (Durchfallen) und Bereiche ---
r$=""
SELECT 2
CASE 1
  r$=r$+"1"
CASE 2
  r$=r$+"2"
  CONT
CASE 3
  r$=r$+"3"
CASE 4
  r$=r$+"4"
DEFAULT
  r$=r$+"D"
ENDSELECT
PRINT #1,"T6 CONT: ";r$
r$=""
SELECT 7
CASE TO 3
  r$="<=3"
CASE 5 TO 8,20
  r$="5..8,20"
CASE 9 TO
  r$=">=9"
ENDSELECT
PRINT #1,"T7 Bereich 7: ";r$
r$=""
SELECT ASC("m")
CASE "a" TO "z"
  r$="klein"
DEFAULT
  r$="sonst"
ENDSELECT
PRINT #1,"T8 a TO z: ";r$
r$=""
SELECT 2.7
CASE 2
  r$="2"
CASE 3
  r$="3"
DEFAULT
  r$="D"
ENDSELECT
PRINT #1,"T9 SELECT 2.7: ";r$
'
' --- 3. PRINT USING ---
@us("T10 #.####",PI,"#.####")
@us("T11 ###.##^^^^ 16",16,"###.##^^^^")
@us("T12 ###.##^^^^ 4100",4100,"###.##^^^^")
@us("T13 #.##^^^^ 0.000123",0.000123,"#.##^^^^")
@us("T14 # 0.5",0.5,"#")
@us("T15 # 1.5",1.5,"#")
@us("T16 # 2.5",2.5,"#")
@us("T17 #.# 0.25",0.25,"#.#")
@us("T18 #.# 0.35",0.35,"#.#")
@us("T19 # -2.5",-2.5,"#")
@us("T20 ## 1234",1234,"##")
@us("T21 -##.# -1.25",-1.25,"-##.#")
@us("T22 -##.# 1.25",1.25,"-##.#")
@us("T23 +## 5",5,"+##")
@us("T24 ##.#- -3",-3,"##.#-")
@us("T25 ***# 12",12,"***#")
@us("T26 $##.## 3.5",3.5,"$##.##")
@us("T27 ###.## -0.5",-0.5,"###.##")
@us("T28 #,###.## 1234.5",1234.5,"#,###.##")
@us("T29 .## 0.5",0.5,".##")
PRINT #1,"T30 &: [";
PRINT #1,USING "&","abc";
PRINT #1,"] !: [";
PRINT #1,USING "!","abc";
PRINT #1,"] \  \: [";
PRINT #1,USING "\  \","abcdef";
PRINT #1,"] _: [";
PRINT #1,USING "PI_._._. #.###",PI;
PRINT #1,"]"
PRINT #1,"T31 zwei Werte: [";
PRINT #1,USING "##.# ",1.25,2.75;
PRINT #1,"]"
'
' --- 4. MODE ---
FOR m%=0 TO 3
  MODE m%
  PRINT #1,"T32 MODE ";m%;": [";
  PRINT #1,USING "#,###.##",1234.5;
  PRINT #1,"] str$=[";STR$(1234.5,8,2);"] print=[";1234.5;"]"
NEXT m%
MODE 0
'
' --- 5. STR$ mit Laenge ---
PRINT #1,"T33 [";STR$(123.4567,6,2);"] [";STR$(PI,5,3);"] [";STR$(42,5);"] [";STR$(123456,3);"]"
PRINT #1,"T34 [";STR$(-1.5,4,0);"] [";STR$(2.5,3,0);"] [";STR$(0.05,4,1);"] [";STR$(12345.6,4,1);"]"
'
' --- 6. Operatoren und Wahrheitswerte ---
PRINT #1,"T35 -2^2=";-2^2;" 2^3^2=";2^3^2;" 2*3^2=";2*3^2
PRINT #1,"T36 7 MOD 3*2=";7 MOD 3*2;" 7 DIV 2*2=";7 DIV 2*2;" 7\2*2=";7\2*2
PRINT #1,"T37 TRUE=";TRUE;" FALSE=";FALSE;" (3>2)=";(3>2);" (3>2)*5=";(3>2)*5
PRINT #1,"T38 NOT 0=";NOT 0;" NOT 1=";NOT 1;" 3.7 AND 6=";3.7 AND 6;" -1.5 OR 0=";-1.5 OR 0
PRINT #1,"T39 1+2=3 AND 4: ";1+2=3 AND 4;" 5 AND 3=3: ";5 AND 3=3
PRINT #1,"T40 1 OR 2 AND 0=";1 OR 2 AND 0;" 6 XOR 3=";6 XOR 3;" 6 IMP 3=";6 IMP 3;" 6 EQV 3=";6 EQV 3
'
' --- 7. Strings ---
PRINT #1,"T41 a<B:";"a"<"B";" abc<abd:";"abc"<"abd";" ab<abc:";"ab"<"abc";" leer<a:";""<"a"
PRINT #1,"T42 INSTR: ";INSTR("","");" ";INSTR("abc","");" ";INSTR("abc","",3);" ";INSTR("abc","",5);" ";INSTR("abcabc","c",4);" ";INSTR(4,"abcabc","c")
PRINT #1,"T43 MID$: [";MID$("abc",5);"] [";MID$("abc",2,10);"] [";LEFT$("abc",10);"] [";RIGHT$("abc",0);"]"
PRINT #1,"T44 MID$(x,0)"
PRINT #1,"   [";MID$("abc",0,2);"]"
PRINT #1,"T45 LEFT$(x,-1)"
PRINT #1,"   [";LEFT$("abc",-1);"]"
a$="Testwert"
MID$(a$,5,2)="wer war das ?"
b$="abc"
MID$(b$,2)="XYZ"
PRINT #1,"T46 MID$= [";a$;"] [";b$;"]"
PRINT #1,"T47 VAL?: ";VAL?("3.00 DM");" ";VAL?("x");" ";VAL?(" 12");" ";VAL?("1E");" VAL(1E)=";VAL("1E")
PRINT #1,"T48 TRIM$=[";TRIM$("  a b  ");"] UPPER$=[";UPPER$("abc");"]"
PRINT #1,"T49 STRING$=[";STRING$(3,"ab");"] SPACE$(0)=[";SPACE$(0);"]"
PRINT #1,"T50 CHR$(0) LEN=";LEN("a"+CHR$(0)+"b");" ASC leer=";ASC("")
'
PRINT #1,"ende"
CLOSE #1
PRINT "fertig: ";datei$
END
'
PROCEDURE fehler
  ' Original: after an error channel #1 is unusable (ERR 24 file not open)
  ' until it is closed and opened again
  e%=ERR
  CLOSE #1
  OPEN "A",#1,datei$
  PRINT #1,"   -> ERR ";e%;" ";ERR$(e%)
  ON ERROR GOSUB fehler
  RESUME NEXT
RETURN
'
PROCEDURE us(t$,x,f$)
  PRINT #1,t$;": [";
  PRINT #1,USING f$,x;
  PRINT #1,"]"
RETURN
'
PROCEDURE sel1(v%)
  r$="-"
  SELECT v%
  CASE "a"
    r$="a"
  ENDSELECT
  PRINT #1,"T5 ";v%;" CASE a: ";r$
RETURN
'
PROCEDURE sel2(v%)
  r$="-"
  SELECT v%
  CASE "ab"
    r$="ab"
  ENDSELECT
  PRINT #1,"T1/2 ";v%;" CASE ab: ";r$
RETURN
'
PROCEDURE sel4(v%)
  r$="-"
  SELECT v%
  CASE "abcd"
    r$="abcd"
  ENDSELECT
  PRINT #1,"T3/4 ";v%;" CASE abcd: ";r$
RETURN
