' probe5 - Operator-Rangfolge, INSTR, STR$(x,n), PRINT USING (GFA-BASIC 3.5, Amiga)
' Ergebnisdatei: gfa_run.py setzt datei$ auf DH0:probe5.txt (docs/gfa-original.md).
'
datei$="DH0:probe5.txt"
OPEN "O",#1,datei$
ON ERROR GOSUB fehler
PRINT #1,"probe5"
'
' --- 1. Rangfolge ---
' MOD unter + : 3, ueber + : 2
PRINT #1,"T1 7 MOD 3+1=";7 MOD 3+1
' DIV unter + : 2, ueber + : 4
PRINT #1,"T2 7 DIV 2+1=";7 DIV 2+1
' \ unter + : 2, ueber + : 4
PRINT #1,"T3 7\2+1=";7\2+1
' MOD unter / : 1, ueber / : 4
PRINT #1,"T4 8/2 MOD 3=";8/2 MOD 3
' links nach rechts: 0, rechts nach links: Fehler 0
PRINT #1,"T5 9 DIV 4 MOD 2"
PRINT #1,"   ";9 DIV 4 MOD 2
' gleich, von links: 1, OR staerker: 0
PRINT #1,"T6 0 AND 0 OR 1=";0 AND 0 OR 1
' gleich, von links: 0, AND staerker: 1
PRINT #1,"T7 1 XOR 1 AND 0=";1 XOR 1 AND 0
' gleich, von links: 1, XOR staerker: 0
PRINT #1,"T8 0 AND 0 XOR 1=";0 AND 0 XOR 1
' gleich, von links: 3, XOR staerker: 1
PRINT #1,"T9 1 OR 2 XOR 2=";1 OR 2 XOR 2
' NOT ueber + : 0, unter + : -2
PRINT #1,"T10 NOT 0+1=";NOT 0+1
' NOT ueber AND : 0 AND 1 = 0, unter AND : NOT 0 = -1
PRINT #1,"T11 NOT 1 AND 1=";NOT 1 AND 1
' Vergleich unter + : -1
PRINT #1,"T12 1+1=2: ";1+1=2;" 2=1+1: ";2=1+1
' Vergleich unter MOD : 7 MOD 3 = 1 -> -1
PRINT #1,"T13 7 MOD 3=1: ";7 MOD 3=1
PRINT #1,"T14 -3 MOD 2=";-3 MOD 2;" -(3 MOD 2)=";-(3 MOD 2);" 2*-3=";2*-3
'
' --- 2. INSTR mit leerem Suchstring ---
PRINT #1,"T15 INSTR(abc,,n) n=1..5: ";INSTR("abc","",1);" ";INSTR("abc","",2);" ";INSTR("abc","",3);" ";INSTR("abc","",4);" ";INSTR("abc","",5)
PRINT #1,"T16 INSTR(,,n) n=1,2: ";INSTR("","",1);" ";INSTR("","",2);" INSTR(a,a)=";INSTR("a","a")
PRINT #1,"T17 INSTR(abc,c,0)"
PRINT #1,"   ";INSTR("abc","c",0)
PRINT #1,"T18 INSTR(abc,c,-1)"
PRINT #1,"   ";INSTR("abc","c",-1)
'
' --- 3. STR$(x,n) ---
PRINT #1,"T19 [";STR$(123456,3);"] [";STR$(-12,2);"] [";STR$(1.5,2);"] [";STR$(12,5);"] [";STR$(-0.5,3);"]"
PRINT #1,"T20 [";STR$(12345.6,4,1);"] [";STR$(12345.6,3,0);"] [";STR$(-1.25,3,1);"] [";STR$(1,0)
PRINT #1,"]"
'
' --- 4. PRINT USING Randfaelle ---
@us("T21 .## 0.25",0.25,".##")
@us("T22 .## 0.5",0.5,".##")
@us("T23 #.## 0.5",0.5,"#.##")
@us("T24 .# 0.25",0.25,".#")
@us("T25 ## -5",-5,"##")
@us("T26 ## -15",-15,"##")
@us("T27 #.# 99.96",99.96,"#.#")
@us("T28 ##.## 0.004999",0.004999,"##.##")
@us("T29 ##.## 0.005",0.005,"##.##")
PRINT #1,"T30 [";
PRINT #1,USING "##.#",1.25,2.75;
PRINT #1,"]"
PRINT #1,"T31 [";
PRINT #1,USING "#.#|",1.25,2.75;
PRINT #1,"]"
'
PRINT #1,"ende"
CLOSE #1
PRINT "fertig: ";datei$
END
'
PROCEDURE fehler
  ' Original: after an error channel #1 is unusable (ERR 24 file not open)
  ' until it is closed and opened again
  e%=ERR
  CLOSE #1
  OPEN "A",#1,datei$
  PRINT #1,"   -> ERR ";e%;" ";ERR$(e%)
  ON ERROR GOSUB fehler
  RESUME NEXT
RETURN
'
PROCEDURE us(t$,x,f$)
  PRINT #1,t$;": [";
  PRINT #1,USING f$,x;
  PRINT #1,"]"
RETURN
