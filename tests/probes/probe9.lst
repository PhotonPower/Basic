' probe9 - Fehlernummern fuer den Interpreter (GFA-BASIC 3.5, Amiga)
' Ergebnisdatei: gfa_run.py setzt datei$ auf DH0:probe9.txt (docs/gfa-original.md).
'
datei$="DH0:probe9.txt"
OPEN "O",#1,datei$
ON ERROR GOSUB fehler
PRINT #1,"probe9"
'
PRINT #1,"T1 READ ohne DATA"
READ a,b,c
PRINT #1,"   a=";a;" b=";b;" c=";c
PRINT #1,"T2 READ Text in Zahl"
READ x
PRINT #1,"   x=";x
PRINT #1,"T3 DIM doppelt"
DIM f%(3)
DIM f%(5)
PRINT #1,"T4 Feld ohne DIM"
g%(1)=5
PRINT #1,"T5 Index -1"
f%(-1)=1
PRINT #1,"T6 ERROR 200"
ERROR 200
PRINT #1,"T7 ERR$ 7 8 9 11 12 13 14 15"
FOR i%=7 TO 15
  PRINT #1,"   ";i%;" ";ERR$(i%)
NEXT i%
PRINT #1,"T8 ERR$ 17..23"
FOR i%=17 TO 23
  PRINT #1,"   ";i%;" ";ERR$(i%)
NEXT i%
PRINT #1,"T9 ERR$ 25..35"
FOR i%=25 TO 35
  PRINT #1,"   ";i%;" ";ERR$(i%)
NEXT i%
PRINT #1,"T10 CHR$(300)=";ASC(CHR$(300));" STRING$(2,65)=";STRING$(2,65)
PRINT #1,"T11 HEX$(-1)=";HEX$(-1);" HEX$(255,4)=";HEX$(255,4);" BIN$(5,8)=";BIN$(5,8);" OCT$(8)=";OCT$(8)
PRINT #1,"T12 ODD(3)=";ODD(3);" EVEN(0)=";EVEN(0);" SGN(-2)=";SGN(-2);" ABS(-2)=";ABS(-2)
PRINT #1,"T13 PRED(5)=";PRED(5);" SUCC(b)=";SUCC("b");" MAX(1,3,2)=";MAX(1,3,2);" MIN(b,a)=";MIN("b","a")
PRINT #1,"T14 ADD(2147483647,1)"
PRINT #1,"   ";ADD(2147483647,1)
PRINT #1,"T15 SHL(1,31)=";SHL(1,31);" SHR(-1,28)=";SHR(-1,28);" ROR|(129,1)=";ROR|(129,1);" SHL&(1,15)=";SHL&(1,15)
PRINT #1,"T16 BSET(0,3)=";BSET(0,3);" BTST(8,3)=";BTST(8,3);" SWAP(1)=";SWAP(1);" WORD(65535)=";WORD(65535)
PRINT #1,"T17 UPPER$=";UPPER$("aZ1")
PRINT #1,"T18 DIM? ";DIM?(f%())
DATA 1,abc
'
PRINT #1,"ende"
CLOSE #1
PRINT "fertig: ";datei$
END
'
PROCEDURE fehler
  ' Original: after an error channel #1 is unusable (ERR 24 file not open)
  ' until it is closed and opened again
  e%=ERR
  CLOSE #1
  OPEN "A",#1,datei$
  PRINT #1,"   -> ERR ";e%;" ";ERR$(e%)
  ON ERROR GOSUB fehler
  RESUME NEXT
RETURN
