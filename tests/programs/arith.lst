' test: groups core float print
' Arithmetik: Ganzzahl und Float, Zuweisung, Rundung, Operatoren
a%=2147483647
x=a%+1
PRINT x;" ";a%*2;" ";a%+1-1
b%=7
c%=-7
PRINT b% DIV 2;" ";c% DIV 2;" ";c% MOD 2;" ";b% MOD -2;" ";c%\2
w&=32767
INC w&
PRINT w&
y|=0
DEC y|
PRINT y|
f=2.5
i%=f
j%=-f
k%=7/2
PRINT i%;" ";j%;" ";k%
PRINT CINT(2.5);" ";CINT(-2.5);" ";INT(-0.5);" ";TRUNC(-1.7);" ";FRAC(-1.25)
PRINT ROUND(2.5);" ";ROUND(-2.5);" ";ROUND(1250,-2);" ";ROUND(0.125,2)
PRINT -2^2;" ";2^3^2;" ";2*-3;" ";2^-1;" ";7 MOD 3*2;" ";7 MOD 3+1
PRINT 1 OR 2 AND 0;" ";NOT 0+1;" ";NOT 1 AND 1;" ";6 XOR 3;" ";6 IMP 3;" ";6 EQV 3
PRINT 3.7 AND 6;" ";-1.5 OR 0;" ";TRUE;" ";FALSE;" ";(3>2)*5
PRINT 1==1+2^(-29);" ";1==1+2^(-28);" ";1.5<>1.5;" ";2>=2
PRINT 1/3;" ";2/3;" ";100/3;" ";1E15;" ";-1E-100;" ";1E-5;" ";1E-6;" ";123456789012
PRINT 0.5;" ";-0.5;" ";1E13;" ";1E14;" ";2^31;" ";-0
PRINT SQR(2);" ";ABS(-3);" ";SGN(-0.1);" ";MAX(3,1,2);" ";MIN(3,1,2)
PRINT ADD(2147483647,1);" ";SUB(5,7);" ";MUL(6,7);" ";DIV(-7,2);" ";MOD(-7,2)
PRINT SHL(1,31);" ";SHR(-1,28);" ";ROR|(129,1);" ";SHL&(1,15);" ";ROL(1,33)
PRINT BSET(0,3);" ";BCLR(15,0);" ";BCHG(5,2);" ";BTST(8,3);" ";SWAP(1);" ";WORD(65535);" ";BYTE(256);" ";CARD(-1)
PRINT ODD(3);" ";EVEN(3);" ";PRED(5);" ";SUCC(5)
