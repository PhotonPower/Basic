' test: groups core float print
' Messprogramm (Meilenstein 0.6): Mandelbrot-Menge 32 x 12 Zeichen mit Fliesskomma.
FOR y%=0 TO 11
  ci=y%/6-1
  z$=""
  FOR x%=0 TO 31
    cr=x%/12-2
    zr=0
    zi=0
    n%=0
    WHILE n%<24 AND zr*zr+zi*zi<4
      t=zr*zr-zi*zi+cr
      zi=2*zr*zi+ci
      zr=t
      INC n%
    WEND
    z$=z$+MID$(" .:-=+*#%@",n% DIV 3+1,1)
  NEXT x%
  PRINT z$
NEXT y%
s=0
FOR i%=1 TO 200
  s=s+SQR(i%)*SIN(i%/10)
NEXT i%
PRINT s
