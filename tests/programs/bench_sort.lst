' test: groups core print
' Messprogramm (Meilenstein 0.6): Bubblesort von 150 Zahlen aus einem linearen Kongruenzgenerator.
DIM a%(149)
x%=12345
FOR i%=0 TO 149
  x%=(x%*1103+12345) MOD 32768
  a%(i%)=x%
NEXT i%
FOR i%=149 DOWNTO 1
  FOR j%=0 TO i%-1
    IF a%(j%)>a%(j%+1)
      SWAP a%(j%),a%(j%+1)
    ENDIF
  NEXT j%
NEXT i%
c%=0
FOR i%=0 TO 149
  c%=(c%*31+a%(i%)) MOD 1000003
NEXT i%
PRINT a%(0);" ";a%(75);" ";a%(149);" Pruefsumme ";c%
