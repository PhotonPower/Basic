' test: groups core print file-seq
' Verzeichnisse, FILES/DIR, RESERVE/FRE und SOUND (probe25 T1-T7). Arbeitet im Unterverzeichnis
' zzdirs und raeumt am Ende auf; FILES ohne Uhrzeit (die Spalten bis 39).
PRINT FRE();" ";FRE(0)
x=5
RESERVE 100000
PRINT FRE(0);" ";x
MKDIR "zzdirs"
MKDIR "zzdirs"
OPEN "O",#2,"zzdirs/a.txt"
PRINT #2,"hallo"
CLOSE #2
MKDIR "zzdirs/sub"
DIR "zzdirs"
FILES "zzdirs" TO "zzdirsfiles"
OPEN "I",#1,"zzdirsfiles"
LINE INPUT #1,l$
PRINT LEN(l$);" ";LEFT$(l$,39)
CLOSE #1
CHDIR "zzdirs"
PRINT "dir$ ";RIGHT$(DIR$(0),6)="zzdirs"
PRINT EXIST("a.txt");EXIST("sub")
CHDIR "/"
PRINT EXIST("zzdirs/a.txt")
ON ERROR GOSUB f
RMDIR "zzdirs"
RMDIR "zzdirs/sub"
RMDIR "zzdirs/a.txt"
PRINT EXIST("zzdirs/a.txt")
RMDIR "zzdirs"
KILL "zzdirsfiles"
SOUND 440,20
PROCEDURE f
  PRINT "ERR ";ERR
  ON ERROR GOSUB f
  RESUME NEXT
RETURN
