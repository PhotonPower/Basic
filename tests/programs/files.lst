' test: groups core print file-seq
' source: GFA-BASIC 3.5
' Sequentielle Dateien (aus probe14): Zeilenende, PRINT #, WRITE #, INPUT #, LINE INPUT #, INPUT$,
' EOF, LOF, EXIST, KILL, CLOSE, Fehler 21-26 und die Dateisystemfehler -51/-54. Die Dateien liegen
' im aktuellen Verzeichnis und werden am Ende geloescht.
ON ERROR GOSUB fehler
PRINT "probe14"
'
' T1 Zeilenende und Laenge: PRINT # schreibt "ab" und ein Zeilenende
OPEN "O",#2,"p14a.dat"
PRINT #2,"ab"
CLOSE #2
OPEN "I",#2,"p14a.dat"
l%=LOF(#2)
s$=INPUT$(l%,#2)
CLOSE #2
PRINT "T1 LOF=";l%;" Bytes:";
FOR i%=1 TO LEN(s$)
  PRINT " ";ASC(MID$(s$,i%,1));
NEXT i%
PRINT
'
' T2 PRINT # mit Zahlen, Strichpunkt, Komma (Zonen?) und Apostroph
OPEN "O",#2,"p14b.dat"
PRINT #2,1;-2;3.5
PRINT #2,"x",7,"y"
PRINT #2,"a";
PRINT #2,"b"'"c"
CLOSE #2
OPEN "I",#2,"p14b.dat"
WHILE NOT EOF(#2)
  LINE INPUT #2,z$
  PRINT "T2 [";z$;"] ";LEN(z$)
WEND
CLOSE #2
'
' T3 WRITE #
OPEN "O",#2,"p14c.dat"
WRITE #2,1,"zwei",-3.5,""
WRITE #2,"a,b","c""d"
CLOSE #2
OPEN "I",#2,"p14c.dat"
WHILE NOT EOF(#2)
  LINE INPUT #2,z$
  PRINT "T3 [";z$;"]"
WEND
CLOSE #2
'
' T4 INPUT # liest Werte (Komma, Anfuehrungszeichen, Leerzeichen)
OPEN "O",#2,"p14d.dat"
PRINT #2,"  12 , abc ,"+CHR$(34)+"x,y"+CHR$(34)+",-7.5"
PRINT #2,"eins zwei"
PRINT #2,"3"
CLOSE #2
OPEN "I",#2,"p14d.dat"
INPUT #2,a,b$,c$,d
PRINT "T4 a=";a;" b$=[";b$;"] c$=[";c$;"] d=";d
INPUT #2,e$
PRINT "T4 e$=[";e$;"]"
INPUT #2,f
PRINT "T4 f=";f;" EOF=";EOF(#2)
INPUT #2,g
PRINT "T4 nach dem Ende: g=";g
CLOSE #2
'
' T5 INPUT # einer Zahl aus Text
OPEN "O",#2,"p14e.dat"
PRINT #2,"abc"
PRINT #2,"12abc"
CLOSE #2
OPEN "I",#2,"p14e.dat"
INPUT #2,h
PRINT "T5 h=";h
INPUT #2,h
PRINT "T5 h=";h
CLOSE #2
'
' T6 Anhaengen, LOF, EXIST, KILL
OPEN "A",#2,"p14a.dat"
PRINT #2,"cd"
CLOSE #2
OPEN "I",#2,"p14a.dat"
PRINT "T6 LOF nach A: ";LOF(#2)
LINE INPUT #2,z$
LINE INPUT #2,y$
PRINT "T6 [";z$;"][";y$;"] EOF=";EOF(#2)
CLOSE #2
PRINT "T6 EXIST: ";EXIST("p14a.dat");" ";EXIST("gibtsnicht.dat")
KILL "p14a.dat"
PRINT "T6 nach KILL: ";EXIST("p14a.dat")
'
' T7 Fehler
PRINT "T7 OPEN I einer fehlenden Datei"
OPEN "I",#2,"gibtsnicht.dat"
PRINT "T7 OPEN mit falschem Modus"
OPEN "Z",#2,"p14z.dat"
PRINT "T7 Kanal zweimal"
OPEN "O",#2,"p14z.dat"
OPEN "O",#2,"p14z.dat"
CLOSE #2
PRINT "T7 Kanal 0"
OPEN "O",#0,"p14z.dat"
PRINT "T7 Kanal 100"
OPEN "O",#100,"p14z.dat"
PRINT "T7 Kanal 99"
OPEN "O",#99,"p14z.dat"
CLOSE #99
PRINT "T7 PRINT # auf geschlossenen Kanal"
PRINT #3,"x"
PRINT "T7 INPUT # auf Ausgabedatei"
OPEN "O",#2,"p14z.dat"
INPUT #2,x
CLOSE #2
PRINT "T7 KILL einer fehlenden Datei"
KILL "gibtsnicht.dat"
KILL "p14z.dat"
'
' T8 CLOSE ohne Kanal schliesst alle? (danach Kanal 1 wieder oeffnen)
OPEN "O",#2,"p14f.dat"
OPEN "O",#3,"p14g.dat"
CLOSE
PRINT "T8 nach CLOSE: Kanal 2 wieder frei"
OPEN "O",#2,"p14f.dat"
CLOSE #2
KILL "p14b.dat"
KILL "p14c.dat"
KILL "p14d.dat"
KILL "p14e.dat"
KILL "p14f.dat"
KILL "p14g.dat"
KILL "p14z.dat"
'
PRINT "ende"
END
'
PROCEDURE fehler
  e%=ERR
  PRINT "   -> ERR ";e%;" ";ERR$(e%)
  ON ERROR GOSUB fehler
  RESUME NEXT
RETURN
