' test: groups core print graphics
' Grafik (D25): Rasterregeln wie am Original gemessen (probe22-24), ein Stift fuer COLOR und
' DEFFILL, BOUNDARY, XOR mit dem ersten Punkt, Linienmuster, SETCOLOR, Fenster, TEXT, POINT.
' Die POINT-Werte stammen aus Faellen, die probe22-24 am Original bestaetigt haben.
OPENW 0
CLEARW 0
COLOR 1
LINE 0,10,9,13
FOR y%=10 TO 13
  FOR x%=0 TO 9
    PRINT POINT(x%,y%);
  NEXT x%
  PRINT
NEXT y%
COLOR 1,0,2
DEFFILL 3,1
BOX 0,30,5,33
BOUNDARY 1
PBOX 8,30,13,33
BOUNDARY 0
PRINT POINT(0,30);POINT(9,31);POINT(8,30)
COLOR 1
GRAPHMODE 2
LINE 0,50,4,50
LINE 0,51,4,51
GRAPHMODE 0
PRINT POINT(0,50);POINT(0,51);POINT(1,51)
COLOR 1,2
GRAPHMODE 1
DEFLINE &HF0F0
LINE 0,72,19,72
GRAPHMODE 0
DEFLINE 1
FOR x%=0 TO 19
  PRINT POINT(x%,72);
NEXT x%
PRINT
COLOR 1
CIRCLE 100,100,9
PRINT POINT(100,96);POINT(100,95);POINT(91,100)
DEFFILL 2,1
PCIRCLE 200,100,6
ELLIPSE 300,100,6,3
PELLIPSE 400,100,6,3
PRINT POINT(-1,0);POINT(1000,0)
SETCOLOR 3,15,0,0
SETCOLOR 2,&H0F0
COLOR 3
DRAW 10,150 TO 300,200 TO 600,150
TEXT 20,220,"Hallo"
TEXT 20,230,1.5
OPENW 1
COLOR 1
PBOX 5,5,50,30
PRINT POINT(10,10)
TITLEW 1,"Fenster 1"
CLOSEW 1
