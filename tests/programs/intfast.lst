' test: groups core print
' Ganzzahl-Abkuerzungen der Assembler-Ziele (D16): a%+b%, a%-b%, a%*b% in Ganzzahlen, Vergleiche,
' FOR mit %-Variable. Die Ergebnisse und Fehler muessen dieselben sein wie mit Float gerechnet.
ON ERROR GOSUB fehler
a%=2147483647
b%=1
m%=-2147483648
c%=a%+b%
PRINT "1 ";c%
c%=a%-(-1)
PRINT "2 ";c%
c%=m%-1
PRINT "3 ";c%
c%=a%+m%
PRINT "4 ";c%
x=a%+b%
PRINT "5 ";x;" ";a%*2;" ";m%-1
w&=32767
w&=w&+1
PRINT "6 ";w&
w&=a%+a%
PRINT "7 ";w&
w&=-32768
w&=w&-1
PRINT "8 ";w&;" ";
w&=-32767
w&=w&-1
PRINT w&
y|=255
y|=y|+1
PRINT "9 ";y|
y|=a%*a%
PRINT "10 ";y|
y|=15*17
PRINT "11 ";y|
c%=46341*46341
PRINT "12 ";c%
c%=46340*46340
PRINT "13 ";c%
c%=-65536*32768
PRINT "14 ";c%
c%=65536*32768
PRINT "15 ";c%
c%=m%*(-1)
PRINT "16 ";c%
c%=m%*1
PRINT "17 ";c%;" ";m%*0;" ";-7*6
n%=0
FOR i%=2147483640 TO 2147483647 STEP 3
  INC n%
NEXT i%
PRINT "18 ";n%;" ";i%
n%=0
FOR i%=-2147483643 TO -2147483648 STEP -2
  INC n%
NEXT i%
PRINT "19 ";n%;" ";i%
n%=0
FOR i%=5 TO 1
  INC n%
NEXT i%
PRINT "20 ";n%;" ";i%
n%=0
FOR i%=10 DOWNTO 1
  n%=n%+i%
NEXT i%
PRINT "21 ";n%;" ";i%
e%=7
n%=0
FOR i%=1 TO e% STEP 2
  INC n%
  e%=100
NEXT i%
PRINT "22 ";n%;" ";i%
PRINT "23 ";a%<m%;" ";m%<a%;" ";a%=a%;" ";-1<=0;" ";b%>=2;" ";b%<>1
' Ketten aus + - * in 32 Bit, bei Ueberlauf eines Zwischenergebnisses der Float-Weg
p%=100000
q%=2147483647
r%=-2147483647-1
x%=p%*p%-p%*p%+1
PRINT "24 ";x%;" ";r%
x%=q%*q%-q%*q%+7
PRINT "25 ";x%
x%=q%+1-1
PRINT "26 ";x%;" ";q%-1+1;" ";r%+1-1
x%=r%*1+0
PRINT "27 ";x%
x%=r%*(-1)+0
PRINT "28 ";x%
x%=q%+q%-q%
PRINT "29 ";x%
w&=p%*2-199999
PRINT "30 ";w&
w&=p%*2+p%
PRINT "31 ";w&
y|=p%-99999+254
PRINT "32 ";y|
y|=p%-99999+255
PRINT "33 ";y|
DIM z%(3)
z%(2)=46341
x%=z%(2)*z%(2)-z%(2)*3
PRINT "34 ";x%
x%=z%(2)*z%(2)+z%(1)
PRINT "35 ";x%
x%=-(r%+1)*1-1
PRINT "36 ";x%
' Multiplikation mit Zweierpotenzen (ASL mit Ueberlaufpruefung)
q%=1073741823
x%=q%*2+0
PRINT "37 ";x%
x%=(q%+1)*2+0
PRINT "38 ";x%
x%=-q%*4+q%*4
PRINT "39 ";x%
r%=-1073741824
x%=r%*2+0
PRINT "40 ";x%
x%=r%*256-r%*256
PRINT "41 ";x%
x%=8*r%/r%+256*q%-256*q%
PRINT "42 ";x%
' FOR mit variabler ganzzahliger Schrittweite: Richtung zur Laufzeit, Ueberlauf, Schritt 0
s%=3
n%=0
FOR i%=2147483640 TO 2147483647 STEP s%
  INC n%
  s%=1
NEXT i%
PRINT "43 ";n%;" ";i%
s%=-2
n%=0
FOR i%=-2147483643 TO -2147483648 STEP s%
  INC n%
NEXT i%
PRINT "44 ";n%;" ";i%
DIM st%(1)
st%(1)=-3
n%=0
FOR i%=10 TO 1 STEP st%(1)
  n%=n%+i%
NEXT i%
PRINT "45 ";n%;" ";i%
s%=0
n%=0
FOR i%=1 TO 0 STEP s%
  INC n%
NEXT i%
PRINT "46 ";n%;" ";i%
n%=0
FOR i%=1 TO 1 STEP s%
  INC n%
  EXIT IF n%=5
NEXT i%
PRINT "47 ";n%;" ";i%
s%=-1
n%=0
FOR i%=1 TO 3 STEP s%
  INC n%
NEXT i%
PRINT "48 ";n%;" ";i%
w&=2
n%=0
FOR i%=0 TO 9 STEP w&
  INC n%
NEXT i%
PRINT "49 ";n%;" ";i%
' FOR mit einer Kette als Ende: 32 Bit, bei Ueberlauf der Kette die Pruefungen in Fliesskomma
e%=10
n%=0
FOR i%=1 TO e%-1
  INC n%
NEXT i%
PRINT "50 ";n%;" ";i%
n%=0
FOR i%=e%*2 DOWNTO e%+1
  INC n%
NEXT i%
PRINT "51 ";n%;" ";i%
m%=2147483647
n%=0
FOR i%=2147483640 TO m%+10 STEP 3
  INC n%
  EXIT IF n%=6
NEXT i%
PRINT "52 ";n%;" ";i%
n%=0
FOR i%=2147483640 TO m%-2 STEP 3
  INC n%
NEXT i%
PRINT "53 ";n%;" ";i%
n%=0
FOR i%=-2147483640 TO -m%-10 STEP -4
  INC n%
  EXIT IF n%=7
NEXT i%
PRINT "54 ";n%;" ";i%
s%=-2
n%=0
FOR i%=0 TO e%*(-1) STEP s%
  INC n%
NEXT i%
PRINT "55 ";n%;" ";i%
n%=0
FOR i%=3 TO m%*2 STEP s%
  INC n%
NEXT i%
PRINT "56 ";n%;" ";i%
n%=0
FOR i%=2147483646 TO m%*2-m%+1 STEP 1
  INC n%
  EXIT IF n%=4
NEXT i%
PRINT "57 ";n%;" ";i%
' STR$ und PRINT einer Ganzzahl: die Ziffern (DEFNUM 13), sonst ueber Float gerundet
DIM zq%(7)
zq%(0)=0
zq%(1)=-1
zq%(2)=7
zq%(3)=2147483647
zq%(4)=-2147483647-1
zq%(5)=1000000000
zq%(6)=-99999
zq%(7)=123456
FOR k%=0 TO 7
  PRINT "58 ";STR$(zq%(k%));"|";zq%(k%);"|";LEN(STR$(zq%(k%)))
NEXT k%
DEFNUM 4
FOR k%=3 TO 7
  PRINT "59 ";STR$(zq%(k%));"|";zq%(k%)
NEXT k%
DEFNUM 13
w&=-32768
b|=255
PRINT "60 ";STR$(w&);" ";STR$(b|);" ";STR$(k%*2)
END
PROCEDURE fehler
  PRINT "Fehler ";ERR
  ON ERROR GOSUB fehler
  RESUME NEXT
RETURN
