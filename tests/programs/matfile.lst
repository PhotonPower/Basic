' test: groups core print file-seq matrix
' MAT PRINT # in eine Datei (D23): Elemente mit ",", jede Zeile endet mit CR LF (probe17 T1).
DIM a(2,3),v(2)
MAT READ a()
v(1)=1/3
v(2)=-1E-20
DATA 1,2.5,-3,4,5,6
OPEN "O",#1,"matfile.dat"
MAT PRINT #1,a()
MAT PRINT #1,a(),6,2
MAT PRINT #1,v()
CLOSE #1
OPEN "I",#1,"matfile.dat"
PRINT LOF(#1)
WHILE NOT EOF(#1)
  LINE INPUT #1,z$
  PRINT LEN(z$);" [";LEFT$(z$,LEN(z$)-1);"] ";ASC(RIGHT$(z$,1))
WEND
CLOSE #1
KILL "matfile.dat"
PRINT "ende"
