' test: groups core float print
' source: GFA-BASIC 3.5
' Transzendente Funktionen (probe13): Fehler an den Raendern, Werte auf 8 Stellen gerundet. Die
' Faelle, in denen das ungenaue Original abweicht (TAN(PI/2), SIN(1E10), SIN(1E20), EXP(700)),
' fehlen hier (D11).
ON ERROR GOSUB fehler
PRINT "T1 EXP(-30000): ";EXP(-30000)
PRINT "T2 EXP(-745): ";EXP(-745)
PRINT "T3 LOG(-1)"
x=LOG(-1)
PRINT "T4 LOG10(0)"
x=LOG10(0)
PRINT "T5 ASIN(2)"
x=ASIN(2)
PRINT "T6 ACOS(-1.5)"
x=ACOS(-1.5)
PRINT "T7 ASIN(1): ";ROUND(ASIN(1),8);" ACOS(-1): ";ROUND(ACOS(-1),8)
PRINT "T8 (-8)^(1/3)"
x=(-8)^(1/3)
PRINT "T9 0^-1"
x=0^-1
PRINT "T10 0^0: ";0^0;" 0^0.5: ";0^0.5;" (-2)^3: ";(-2)^3;" 2^0.5: ";ROUND(2^0.5,8)
PRINT "T14 ATN(1E300): ";ROUND(ATN(1E300),8);" ATN(-1): ";ROUND(ATN(-1),8)
PRINT "T15 EXP(1): ";ROUND(EXP(1),8);" LOG(10): ";ROUND(LOG(10),8);" LOG10(1000): ";LOG10(1000)
PRINT "T16 SIN(0.5): ";ROUND(SIN(0.5),8);" COS(0.5): ";ROUND(COS(0.5),8);" TAN(0.5): ";ROUND(TAN(0.5),8)
PRINT "T17 SINQ(30): ";ROUND(SINQ(30),8);" COSQ(60): ";ROUND(COSQ(60),8);" DEG(1): ";ROUND(DEG(1),8);" RAD(180): ";ROUND(RAD(180),8)
PRINT "T18 ASIN(0.5): ";ROUND(ASIN(0.5),8);" ACOS(0.5): ";ROUND(ACOS(0.5),8)
PRINT "T19 10^-2: ";10^-2;" 2^-0.5: ";ROUND(2^-0.5,8);" 1.5^2.5: ";ROUND(1.5^2.5,8)
PRINT "T20 EXP(0): ";EXP(0);" LOG(1): ";LOG(1);" SIN(0): ";SIN(0);" COS(0): ";COS(0);" ATN(0): ";ATN(0)
PRINT "T21 SINQ(1E10): ";ROUND(SINQ(1E10),6)
PRINT "T22 LOG(1E-300): ";ROUND(LOG(1E-300),6)
PRINT "T23 SIN(-0.5): ";ROUND(SIN(-0.5),8);" COS(-3): ";ROUND(COS(-3),8);" TAN(-1): ";ROUND(TAN(-1),8)
END
PROCEDURE fehler
  e%=ERR
  PRINT "   -> ERR ";e%;" ";ERR$(e%)
  ON ERROR GOSUB fehler
  RESUME NEXT
RETURN
