' test: groups core print memory
' Gruppe memory (D21): PEEK/POKE, BYTE{} ... CHAR{} auf Variablen, Strings, Arrays und MALLOC-Bloecke, BMOVE.
' Die Adressen selbst sind nicht festgelegt, nur die Bytes (Amiga-Layout, hoechstwertiges Byte zuerst).
a%=258
w&=-2
x=1.5
s$="Hallo"
DIM f%(3),g(1)
f%(1)=16909060
PRINT PEEK(V:a%+3);" ";DPEEK(V:a%+2);" ";LPEEK(V:a%);" ";DPEEK(V:w&);" ";PEEK(V:s$+1)
PRINT LPEEK(V:x);" ";HEX$(LPEEK(V:x+4))
POKE V:s$,ASC("h")
LPOKE V:a%,-1
DPOKE V:w&,1000
PRINT s$;" ";a%;" ";w&
PRINT V:f%(2)-V:f%(1);" ";PEEK(V:f%(1)+1);" ";V:g(1)-V:g(0)
m%=MALLOC(16,0)
LPOKE m%,&H41424344
BMOVE m%,V:s$+1,4
PRINT s$;" ";PEEK(m%+15);" ";MFREE(m%,16);" ";MFREE(m%,16)
BMOVE V:f%(1),V:f%(0),8
PRINT f%(0);" ";f%(1)
DPOKE V:x,16384
PRINT x
b|=200
t!=TRUE
POKE V:b|,7
PRINT b|;" ";PEEK(V:t!);" ";PEEK(V:b|)
DIM h&(2)
h&(1)=-3
PRINT DPEEK(V:h&(1));" ";V:h&(2)-V:h&(1)
@lokal
PRINT MALLOC(0);" ";MFREE(12345678,4)
n%=MALLOC(32)
BYTE{n%}=300
PRINT BYTE{n%};" ";PEEK(n%)
INT{n%}=-2
PRINT INT{n%};" ";CARD{n%};" ";WORD{n%}
LONG{n%+4}=-123456
PRINT {n%+4};" ";LONG{n%+4};" ";HEX$(CARD{n%+4})
FLOAT{n%}=0.1
PRINT FLOAT{n%};" ";HEX$(LONG{n%});" ";HEX$(LONG{n%+4})
DOUBLE{n%+8}=1.5
PRINT DOUBLE{n%+8};" ";HEX$(LONG{n%+8})
SINGLE{n%+16}=-0.1
PRINT SINGLE{n%+16};" ";HEX$(LONG{n%+16})
CHAR{n%+20}="Amiga"
PRINT CHAR{n%+20};" ";PEEK(n%+25);" ";LEN(CHAR{n%+22})
x=2.5
PRINT DOUBLE{V:x};" ";FLOAT{V:x}
a$="GFA"
PRINT CHAR{V:a$}
~MFREE(n%,32)
END
PROCEDURE lokal
  LOCAL l%,z
  l%=5
  LPOKE V:l%,LPEEK(V:l%)*3
  z=0.5
  BMOVE V:x,V:z,8
  PRINT l%;" ";z
RETURN
