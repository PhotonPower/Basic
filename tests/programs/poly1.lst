' test: groups core print graphics
' POLYLINE und POLYFILL (probe25 T8): offener Linienzug, gefuellt mit und ohne BOUNDARY, OFFSET.
DIM px%(4),py&(4)
px%(0)=10
py&(0)=10
px%(1)=20
py&(1)=12
px%(2)=16
py&(2)=20
px%(3)=8
py&(3)=17
COLOR 1,0,2
DEFFILL 3,1
POLYLINE 4,px%(),py&()
PRINT POINT(10,10);POINT(9,15);POINT(16,20)
CLEARW 0
POLYFILL 4,px%(),py&()
PRINT POINT(9,15);POINT(14,15);POINT(20,15)
CLEARW 0
BOUNDARY 1
POLYFILL 4,px%(),py&() OFFSET 1,0
PRINT POINT(10,15);POINT(14,15);POINT(11,11)
