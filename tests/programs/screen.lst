' test: groups core print
' POS, CRSCOL/CRSLIN, PRINT AT, LOCATE, HTAB/VTAB, CLS und Komma-Zonen wie console.lst, aber ohne
' Dateien (fuer Ziele ohne Dateisystem); die Ergebnisse werden gesammelt und am Ende ausgegeben.
'
' T1 POS nach Ausgaben auf den Bildschirm
CLS
PRINT "abc";
p1%=POS(0)
PRINT
p2%=POS(0)
PRINT "abcd";CHR$(10);
p3%=POS(0)
PRINT "ab";CHR$(13);
p4%=POS(0)
PRINT "abcde";CHR$(8);
p5%=POS(0)
PRINT "x",
p6%=POS(0)
PRINT
r$="T1 "+STR$(p1%)+" "+STR$(p2%)+" "+STR$(p3%)+" "+STR$(p4%)+" "+STR$(p5%)+" "+STR$(p6%)+"/"
'
' T2 CRSCOL/CRSLIN
CLS
c1%=CRSCOL
l1%=CRSLIN
PRINT "abc";
c2%=CRSCOL
l2%=CRSLIN
PRINT
PRINT
c3%=CRSCOL
l3%=CRSLIN
r$=r$+"T2 "+STR$(c1%)+","+STR$(l1%)+" "+STR$(c2%)+","+STR$(l2%)+" "+STR$(c3%)+","+STR$(l3%)+"/"
'
' T3 PRINT AT, LOCATE, HTAB, VTAB
PRINT AT(5,3);"xy";
c1%=CRSCOL
l1%=CRSLIN
p1%=POS(0)
LOCATE 7,10
c2%=CRSCOL
l2%=CRSLIN
p2%=POS(0)
HTAB 20
c3%=CRSCOL
l3%=CRSLIN
VTAB 4
c4%=CRSCOL
l4%=CRSLIN
PRINT AT(1,1);"z"
c5%=CRSCOL
l5%=CRSLIN
p5%=POS(0)
r$=r$+"T3 "+STR$(c1%)+","+STR$(l1%)+" "+STR$(p1%)+" "+STR$(c2%)+","+STR$(l2%)+" "+STR$(p2%)
r$=r$+" "+STR$(c3%)+","+STR$(l3%)+" "+STR$(c4%)+","+STR$(l4%)+" "+STR$(c5%)+","+STR$(l5%)+" "+STR$(p5%)+"/"
'
' T4 TAB nach PRINT AT
PRINT AT(10,5);"a";TAB(20);"b";
c1%=CRSCOL
p1%=POS(0)
r$=r$+"T4 "+STR$(c1%)+" "+STR$(p1%)+"/"
'
' T5 Grenzen: LOCATE mit 0 und negativen Werten
LOCATE 0,-3
c1%=CRSCOL
l1%=CRSLIN
r$=r$+"T5 "+STR$(c1%)+","+STR$(l1%)+"/"
'
' T7 POS nach PRINT TAB und SPC
CLS
PRINT TAB(8);"a";
p1%=POS(0)
PRINT SPC(3);"b";
p2%=POS(0)
PRINT
r$=r$+"T7 "+STR$(p1%)+" "+STR$(p2%)+"/"
'
' T8 Komma-Zonen nach mehreren Anweisungen, PRINT AT, CR und LOCATE
CLS
PRINT "abc";
PRINT "d",
p1%=POS(0)
c1%=CRSCOL
PRINT
PRINT "abcdefgh";CHR$(13);
PRINT "x",
p2%=POS(0)
c2%=CRSCOL
PRINT
PRINT "abc";
LOCATE 30,15
PRINT "y",
p3%=POS(0)
c3%=CRSCOL
PRINT
r$=r$+"T8 "+STR$(p1%)+","+STR$(c1%)+" "+STR$(p2%)+","+STR$(c2%)+" "+STR$(p3%)+","+STR$(c3%)
PRINT
PRINT r$
PRINT "ende"
END
